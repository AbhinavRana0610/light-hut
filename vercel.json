{
  "installCommand": "npm --prefix client install --include=dev",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 npm --prefix client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://light-hut-live.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://light-hut-live.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
